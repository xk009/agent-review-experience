{
  "theme": "auto",
  "tui": "fullscreen",
  "maxProseWidth": 100,
  "language": "Simplified Chinese",
  "outputStyle": "Pyramid",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.html) open \"$f\" ;; esac; exit 0"
          }
        ]
      }
    ]
  }
}
